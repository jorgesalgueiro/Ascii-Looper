{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASCII Looper",
  "version": "0.76.18",
  "identifier": "com.asciilooper.native",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/assemble-web.cjs",
    "beforeBuildCommand": "node scripts/assemble-web.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ASCII Looper",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --disable-features=CalculateNativeWinOcclusion --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "capabilities": ["default"],
      "dangerousDisableAssetCspModification": true,
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost ws://127.0.0.1:* http://127.0.0.1:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; font-src 'self' data:;",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "cross-origin",
        "Tauri-Custom-Header": "Cache-Control: no-store"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ASCII Looper",
    "category": "Music",
    "copyright": "Copyright (c) 2026 Jorge Salgueiro",
    "license": "GPL-3.0-only",
    "shortDescription": "Live looping station with native ASIO / PipeWire audio",
    "longDescription": "ASCII Looper is a live looping station. This build adds a native ASIO / PipeWire / JACK / ALSA audio backend while keeping the existing Web Audio DSP graph for the browser build.",
    "icon": [
      "../favicon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "licenseFile": "../LICENSE",
    "resources": [
      "resources/LICENSE",
      "resources/ASIO-SDK-LICENSE.txt",
      "resources/SOUNDTOUCH-LICENSE.txt",
      "resources/SOURCE.md"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
